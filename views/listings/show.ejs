<% layout("/layouts/boilerplate" ) %>
  <div class="row">
    <div class="col-8 offset-2 mt-3 mb-3">

      <h3><b>
          <%= listing.title %>
        </b></h3>
      <div class="listing-card col-6 offset-3 show-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image" />

        <div class="card-body">
          <p class="card-text">Owned By - <i>
              <%= listing.owner.username %>
            </i></p>
          <p class="card-text">
            <%= listing.description %>
          </p>
          <p class="card-text"> &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night</p>
          <p class="card-text">
            <%= listing.location %>
          </p>
          <p class="card-text">
            <%= listing.country %>
          </p>
          </p>
        </div>
      </div>

      <br />

      <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="btns">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>


          <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
            <button class="btn btn-dark offset-5">Delete</button>
          </form>
        </div>
        <% } %>
          <!-- for review Section  -->
          <div class="col-8 offset-3 mb-3 review-section">
            <% if(currUser) { %>
              <div class="review-form-card">
                <h4 class="review-section-title">Leave a review</h4>
                <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

                  <div class="mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-checkmark">
                      <input
                       type="radio"
                       id="no-rate"
                       class="input-no-rate"
                       name="review[rating]"
                       value="1"
                       checked
                        aria-label="No rating."
                         />
                      <input
                      type="radio"
                       id="first-rate1"
                        name="review[rating]"
                        value="1"
                        />
                      <label
                      for="first-rate1"
                      title="Terrible">
                      1 star
                    </label>
                      <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                      <label for="first-rate2" title="Not good">2 stars</label>
                      <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                      <label for="first-rate3" title="Average">3 stars</label>
                      <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                      <label for="first-rate4" title="Very good">4 stars</label>
                      <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                      <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                  </div>
                  <div class="mb-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea class="form-control" id="comment" name="review[Comment]" cols="30" rows="4"
                      required></textarea>
                    <div class="invalid-feedback">Please submit some comment for reviews</div>
                  </div>
                  <button type="submit" class="btn review-submit-btn">Submit</button>
                </form>
              </div>
              <% } %>

                <h4 class="review-section-title">All Reviews
                  <span class="review-count">(<%= listing.reviews.length %>)</span>
                </h4>
                <div class="row g-3">
                  <% for(review of listing.reviews) { %>
                    <div class="col-md-6">
                      <div class="review-card">
                        <% if(currUser && review.author && currUser._id.equals(review.author._id)) { %>
                          <form class="delete-review-form" method="post"
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="delete-review-btn" aria-label="Delete review" title="Delete review">
                              <i class="fa-solid fa-trash"></i>
                            </button>
                          </form>
                          <% } %>
                        <div class="review-card-header">
                          <div class="review-avatar">
                            <%= (review.author ? review.author.username : "U").charAt(0) %>
                          </div>
                          <div>
                            <h6 class="review-username">@<%= review.author ? review.author.username : "Unknown user" %></h6>
                            <p class="starability-result" data-rating="<%= review.rating %>"></p>
                          </div>
                        </div>
                        <p class="review-comment">
                          <%= review.Comment %>
                        </p>
                      </div>
                    </div>
                    <% } %>
                </div>
          </div>
    </div>
  </div>